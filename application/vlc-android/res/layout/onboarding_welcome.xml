<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hmp_welcome_bg"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="40dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="@string/hmp_logo_h"
                    android:textColor="#CC051A"
                    android:textSize="40sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="serif"
                    android:text="@string/hmp_logo_name"
                    android:textColor="#D7DBE0"
                    android:textSize="30sp" />
        </LinearLayout>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.12"
                android:text="@string/hmp_tagline"
                android:textColor="#8A9099"
                android:textSize="13sp" />

        <TextView
                android:id="@+id/welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:fontFamily="serif"
                android:text="@string/hmp_welcome_heading"
                android:textColor="#D7DBE0"
                android:textSize="44sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/welcome_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:text="@string/hmp_welcome_subtitle"
                android:textColor="#9AA0A8"
                android:textSize="17sp" />

        <Button
                android:id="@+id/google_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/hmp_btn_outline"
                android:fontFamily="serif"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/hmp_continue_google"
                android:textAllCaps="false"
                android:textColor="#E6E8EB"
                android:textSize="16sp" />

        <Button
                android:id="@+id/facebook_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hmp_btn_outline"
                android:fontFamily="serif"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/hmp_continue_facebook"
                android:textAllCaps="false"
                android:textColor="#E6E8EB"
                android:textSize="16sp" />

        <Button
                android:id="@+id/email_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/hmp_btn_outline"
                android:fontFamily="serif"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/hmp_continue_email"
                android:textAllCaps="false"
                android:textColor="#E6E8EB"
                android:textSize="16sp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#33FFFFFF" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/hmp_or"
                    android:textColor="#8A9099"
                    android:textSize="14sp" />

            <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#33FFFFFF" />
        </LinearLayout>

        <Button
                android:id="@+id/guest_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/hmp_btn_guest"
                android:fontFamily="serif"
                android:insetBottom="0dp"
                android:insetTop="0dp"
                android:minHeight="56dp"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="@string/hmp_continue_guest"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        <TextView
                android:id="@+id/hmp_terms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/hmp_terms"
                android:textColor="#8A9099"
                android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
