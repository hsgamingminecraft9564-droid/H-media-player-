<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:vlc="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <variable
                name="fragment"
                type="org.videolan.vlc.gui.audio.AudioPlayer" />

        <variable
                name="ab_repeat_a"
                type="Float" />

        <variable
                name="ab_repeat_b"
                type="Float" />

        <variable
                name="can_shuffle"
                type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/hmp_olive_black">

        <ImageView
                android:id="@+id/backgroundView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.25"
                android:scaleType="centerCrop" />

        <View
                android:id="@+id/top_gradient"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/gradient_audio_player_top_dark"
                app:layout_constraintTop_toTopOf="parent" />

        <View
                android:id="@+id/bottom_gradient"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/gradient_audio_player_bottom_dark"
                app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.3" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.9" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_header_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="56dp" />

        <androidx.constraintlayout.widget.Guideline
                android:id="@+id/centerGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

        <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                app:layout_constraintTop_toTopOf="parent">

            <View
                    android:id="@+id/header_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            <View
                    android:id="@+id/header_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                    android:id="@+id/header_shuffle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onShuffleClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_shuffle_audio" />

            <ImageView
                    android:id="@+id/header_previous"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onPreviousClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_previous" />

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/header_large_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onPlayPauseClick}"
                    android:onLongClick="@{fragment::onStopClick}"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/header_next"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onNextClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_next" />

            <ImageView
                    android:id="@+id/header_repeat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onRepeatClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_repeat_audio" />

            <TextView
                    android:id="@+id/header_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{fragment::onTimeLabelClick}"
                    android:text="@string/time_0"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/header_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onPlayPauseClick}"
                    android:onLongClick="@{fragment::onStopClick}"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/ab_repeat_reset"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onABRepeatResetClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_abrepeat_reset_marker_audio" />

            <ImageView
                    android:id="@+id/ab_repeat_stop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onABRepeatStopClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_abrepeat_reset_audio" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/playlist_search_text"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/playlist_search"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onSearchClick}"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_search_audio" />

            <org.videolan.vlc.gui.view.HeaderMediaSwitcher
                    android:id="@+id/audio_media_switcher"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/playlist_switch"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                    android:id="@+id/playlist_switch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:onClick="@{fragment::onPlaylistSwitchClick}"
                    android:tint="@color/hmp_lime"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/adv_function"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_playlist_audio_on" />

            <ImageView
                    android:id="@+id/adv_function"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:onClick="@{fragment::showAdvancedOptions}"
                    android:tint="@color/hmp_silver"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_overflow_audio" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="header" />

        <org.videolan.vlc.gui.view.CoverMediaSwitcher
                android:id="@+id/cover_media_switcher"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="44dp"
                android:background="@drawable/hmp_cover_frame"
                android:padding="10dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/guideline_header_bottom" />

        <com.google.android.material.chip.ChipGroup
                android:id="@+id/playback_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cover_media_switcher">

            <com.google.android.material.chip.Chip
                        android:id="@+id/playback_speed_quick_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:textColor="?attr/audio_chips_text_color"
                        android:visibility="gone"
                        app:chipBackgroundColor="?attr/audio_chips_color"
                        app:chipIcon="@drawable/ic_speed"
                        app:chipIconTint="?attr/audio_chips_text_color"
                        app:iconStartPadding="8dp"
                        tools:text="1.25x"
                        tools:visibility="visible" />

            <com.google.android.material.chip.Chip
                        android:id="@+id/sleep_quick_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="onClick"
                        android:textColor="?attr/audio_chips_text_color"
                        android:visibility="gone"
                        app:chipBackgroundColor="?attr/audio_chips_color"
                        app:chipIcon="@drawable/ic_sleep"
                        app:chipIconTint="?attr/audio_chips_text_color"
                        app:iconStartPadding="8dp"
                        tools:text="12h55AM"
                        tools:visibility="visible" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
                android:id="@+id/audio_play_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/playback_chips" />

        <org.videolan.vlc.gui.view.AccessibleSeekBar
                android:id="@+id/timeline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                android:progressBackgroundTint="@color/hmp_lime_dim"
                android:progressTint="@color/hmp_lime"
                android:thumb="@drawable/ic_seekbar_thumb_audio"
                android:thumbTint="@color/hmp_lime"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playback_chips" />

        <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:onClick="@{fragment::onTimeLabelClick}"
                android:text="@string/time_0"
                android:textColor="@color/hmp_silver"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timeline" />

        <TextView
                android:id="@+id/length"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:onClick="@{fragment::onTimeLabelClick}"
                android:text="@string/time_0"
                android:textColor="@color/hmp_silver"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/timeline" />

        <LinearLayout
                android:id="@+id/hmp_seek_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time">

            <ImageView
                    android:id="@+id/audio_rewind_bookmark"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{fragment::onPreviousBookmark}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_player_bookmark_previous" />

            <ImageView
                    android:id="@+id/audio_rewind_10"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{fragment::onJumpBack}"
                    android:onLongClick="@{fragment::onJumpBackLong}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_player_rewind_10" />

            <TextView
                    android:id="@+id/audio_rewind_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/audio_forward_10"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{fragment::onJumpForward}"
                    android:onLongClick="@{fragment::onJumpForwardLong}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_player_forward_10" />

            <TextView
                    android:id="@+id/audio_forward_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            <ImageView
                    android:id="@+id/audio_forward_bookmark"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{fragment::onNextBookmark}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_player_bookmark_next" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/hmp_controls_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hmp_seek_row">

            <ImageView
                    android:id="@+id/shuffle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:onClick="@{fragment::onShuffleClick}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    android:visibility="@{can_shuffle ? View.VISIBLE : View.INVISIBLE}"
                    app:srcCompat="@drawable/ic_shuffle_audio" />

            <ImageView
                    android:id="@+id/previous"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:onClick="@{fragment::onPreviousClick}"
                    android:padding="12dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_previous" />

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/play_pause"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/hmp_play_circle_lime"
                    android:elevation="4dp"
                    android:onClick="@{fragment::onPlayPauseClick}"
                    android:onLongClick="@{fragment::onStopClick}"
                    android:padding="22dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/hmp_olive_black" />

            <ImageView
                    android:id="@+id/next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:onClick="@{fragment::onNextClick}"
                    android:padding="12dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_next" />

            <ImageView
                    android:id="@+id/repeat"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:onClick="@{fragment::onRepeatClick}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:srcCompat="@drawable/ic_repeat_audio" />
        </LinearLayout>

        <View
                android:id="@+id/songs_list_guide"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/hmp_controls_row" />

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/songs_list"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:paddingBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hmp_controls_row" />

        <ImageView
                android:id="@+id/hinge_go_left"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_arrow_left" />

        <ImageView
                android:id="@+id/hinge_go_right"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_arrow_right" />

        <FrameLayout
                android:id="@+id/player_options_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        <androidx.appcompat.widget.ViewStubCompat
                    android:id="@+id/player_options_stub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout="@layout/player_options" />

        <androidx.appcompat.widget.ViewStubCompat
                android:id="@+id/bookmarks_stub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout="@layout/bookmarks"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bookmark_marker_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/timeline"
                app:layout_constraintEnd_toEndOf="@id/timeline"
                app:layout_constraintStart_toStartOf="@id/timeline"
                app:layout_constraintTop_toTopOf="@id/timeline" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ab_repeat_marker_guideline_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/timeline"
                app:layout_constraintEnd_toEndOf="@id/timeline"
                app:layout_constraintStart_toStartOf="@id/timeline"
                app:layout_constraintTop_toTopOf="@id/timeline">

            <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/ab_repeat_marker_guideline_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:constraintPercent="@{ab_repeat_a}" />

            <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/ab_repeat_marker_guideline_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:constraintPercent="@{ab_repeat_b}" />

            <ImageView
                    android:id="@+id/ab_repeat_marker_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@id/ab_repeat_marker_guideline_a"
                    app:layout_constraintStart_toStartOf="@id/ab_repeat_marker_guideline_a"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_abrepeat_marker_audio" />

            <ImageView
                    android:id="@+id/ab_repeat_marker_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@id/ab_repeat_marker_guideline_b"
                    app:layout_constraintStart_toStartOf="@id/ab_repeat_marker_guideline_b"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_abrepeat_marker_audio" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
                android:id="@+id/ab_repeat_container"
                layout="@layout/ab_repeat_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@+id/time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
