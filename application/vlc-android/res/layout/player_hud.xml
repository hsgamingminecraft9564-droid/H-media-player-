<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:vlc="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="org.videolan.medialibrary.Tools" />

        <variable
                name="progress"
                type="androidx.lifecycle.LiveData&lt;org.videolan.vlc.media.Progress>" />

        <variable
                name="ab_repeat_a"
                type="Float" />

        <variable
                name="ab_repeat_b"
                type="Float" />

        <variable
                name="player"
                type="org.videolan.vlc.gui.video.VideoPlayerActivity" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/progress_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_hud_player">

            <ImageView
                    android:id="@+id/player_overlay_adv_function"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:onClick="@{(v) -> player.showAdvancedOptions()}"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_player_more" />

            <ImageView
                    android:id="@+id/orientation_toggle"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:tint="@color/hmp_silver"
                    app:layout_constraintEnd_toStartOf="@id/player_overlay_adv_function"
                    app:layout_constraintTop_toTopOf="@id/player_overlay_adv_function"
                    app:srcCompat="@drawable/ic_player_rotate" />

            <LinearLayout
                    android:id="@+id/hmp_center_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <Space
                        android:id="@+id/player_space_left"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                <ImageView
                        android:id="@+id/playlist_previous"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:onClick="@{(v) -> player.previous()}"
                        android:padding="12dp"
                        android:tint="@color/hmp_silver"
                        app:srcCompat="@drawable/ic_player_previous" />

                <ImageView
                        android:id="@+id/player_overlay_rewind"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:tint="@color/hmp_silver"
                        app:srcCompat="@drawable/ic_player_rewind_10" />

                <TextView
                        android:id="@+id/player_overlay_rewind_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                <ImageView
                        android:id="@+id/player_overlay_play"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/hmp_play_circle"
                        android:onClick="@{(v) -> player.doPlayPause()}"
                        android:padding="22dp"
                        android:scaleType="fitCenter"
                        android:tint="@color/white"
                        app:srcCompat="@drawable/ic_pause_player" />

                <ImageView
                        android:id="@+id/player_overlay_forward"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:tint="@color/hmp_silver"
                        app:srcCompat="@drawable/ic_player_forward_10" />

                <TextView
                        android:id="@+id/player_overlay_forward_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                <ImageView
                        android:id="@+id/playlist_next"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:onClick="@{(v) -> player.next()}"
                        android:padding="12dp"
                        android:tint="@color/hmp_silver"
                        app:srcCompat="@drawable/ic_player_next" />

                <Space
                        android:id="@+id/player_space_right"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/hmp_action_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                    <ImageView
                            android:id="@+id/player_resize"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:onClick="@{(v) -> player.resizeVideo()}"
                            android:onLongClick="@{(v) -> player.displayResize()}"
                            android:padding="10dp"
                            android:tint="@color/hmp_silver"
                            app:srcCompat="@drawable/ic_player_ratio" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hmp_ratio_label"
                            android:textColor="@color/hmp_silver"
                            android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                    <ImageView
                            android:id="@+id/player_overlay_tracks"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:onClick="@{player::onAudioSubClick}"
                            android:padding="10dp"
                            android:tint="@color/hmp_silver"
                            app:srcCompat="@drawable/ic_player_audiotrack" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hmp_tracks_label"
                            android:textColor="@color/hmp_silver"
                            android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <org.videolan.vlc.gui.view.FocusableTextView
                    android:id="@+id/player_overlay_time"
                    style="@style/VLC.Player.TimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="14dp"
                    android:onClick="@{(v) -> player.toggleTimeDisplay()}"
                    android:text="@{Tools.millisToString(progress.time)}"
                    app:layout_constraintBottom_toTopOf="@id/hmp_action_row"
                    app:layout_constraintStart_toStartOf="parent" />

            <org.videolan.vlc.gui.view.FocusableTextView
                    android:id="@+id/player_overlay_length"
                    style="@style/VLC.Player.TimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:onClick="@{(v) -> player.toggleTimeDisplay()}"
                    vlc:length="@{progress.length}"
                    vlc:time="@{progress.time}"
                    app:layout_constraintBottom_toBottomOf="@id/player_overlay_time"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/player_overlay_time" />

            <org.videolan.vlc.gui.view.AccessibleSeekBar
                    android:id="@+id/player_overlay_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:progress="@{player.service.getTime(progress.time)}"
                    android:progressBackgroundTint="@color/hmp_crimson_dim"
                    android:progressTint="@color/hmp_crimson"
                    android:thumb="@drawable/ic_seekbar_thumb"
                    android:thumbTint="@color/hmp_crimson"
                    vlc:mediamax="@{(int)progress.length}"
                    app:layout_constraintBottom_toBottomOf="@id/player_overlay_time"
                    app:layout_constraintEnd_toStartOf="@id/player_overlay_length"
                    app:layout_constraintStart_toEndOf="@id/player_overlay_time"
                    app:layout_constraintTop_toTopOf="@id/player_overlay_time" />

            <include
                    android:id="@+id/ab_repeat_container"
                    layout="@layout/ab_repeat_controls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toTopOf="@id/player_overlay_time"
                    app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                    android:id="@+id/ab_repeat_reset"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_abrepeat_reset_marker_circle" />

            <ImageView
                    android:id="@+id/ab_repeat_stop"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="64dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_abrepeat_reset_circle" />

            <ImageView
                    android:id="@+id/fast_seek_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_abrepeat_warning" />

            <androidx.appcompat.widget.ViewStubCompat
                android:id="@+id/bookmarks_stub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout="@layout/bookmarks"
                android:fitsSystemWindows="true"
                vlc:layout_constraintBottom_toBottomOf="parent"
                vlc:layout_constraintEnd_toEndOf="parent"
                vlc:layout_constraintStart_toStartOf="parent"
                vlc:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/bookmark_marker_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/player_overlay_seekbar"
                    app:layout_constraintEnd_toEndOf="@id/player_overlay_seekbar"
                    app:layout_constraintStart_toStartOf="@id/player_overlay_seekbar"
                    app:layout_constraintTop_toTopOf="@id/player_overlay_seekbar" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ab_repeat_marker_guideline_container"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/player_overlay_seekbar"
                    app:layout_constraintEnd_toEndOf="@id/player_overlay_seekbar"
                    app:layout_constraintStart_toStartOf="@id/player_overlay_seekbar"
                    app:layout_constraintTop_toTopOf="@id/player_overlay_seekbar">

                <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ab_repeat_marker_guideline_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        vlc:constraintPercent="@{ab_repeat_a}" />

                <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/ab_repeat_marker_guideline_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        vlc:constraintPercent="@{ab_repeat_b}" />

                <ImageView
                        android:id="@+id/ab_repeat_marker_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="@id/ab_repeat_marker_guideline_a"
                        app:layout_constraintStart_toStartOf="@id/ab_repeat_marker_guideline_a"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_abrepeat_marker" />

                <ImageView
                        android:id="@+id/ab_repeat_marker_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="@id/ab_repeat_marker_guideline_b"
                        app:layout_constraintStart_toStartOf="@id/ab_repeat_marker_guideline_b"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_abrepeat_marker" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/stats_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/playerbackground"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.core.widget.NestedScrollView
                        android:id="@+id/stats_scrollview"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/stats_scrollview_content"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="16dp"
                            android:paddingTop="56dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="24dp">

                        <TextView
                                android:id="@+id/video_stats_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/video_information"
                                android:textColor="@color/hmp_crimson_light"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/stats_graphs"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/video_stats_title">

                            <org.videolan.liveplotgraph.PlotView
                                    android:id="@+id/plotView"
                                    android:layout_width="250dp"
                                    android:layout_height="140dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    vlc:lpg_color="@color/white"
                                    vlc:lpg_plot_view="@+id/plotView" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <LinearLayout
                                android:id="@+id/info_grids"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="vertical"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/stats_graphs" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.core.widget.NestedScrollView>

                <ImageView
                        android:id="@+id/stats_close"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:padding="10dp"
                        android:tint="@color/hmp_silver"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_close_small" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <org.videolan.vlc.gui.view.SwipeToUnlockView
                    android:id="@+id/swipe_to_unlock"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
